# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ScrapeGraphAI uses an LLM to extract structured data from scraped pages.
# By default this project uses OpenAI. Get a key at https://platform.openai.com/
OPENAI_API_KEY=sk-...

# Optional: override the default model (cheaper = gpt-4o-mini, better = gpt-4o)
SCRAPE_MODEL=openai/gpt-4o-mini

# kie.ai API key for the kie-ai MCP server in .mcp.json (image/video/audio generation).
# Get one at https://kie.ai/api-key. Claude Code does NOT read .env: export it in your
# shell (or add it to your Claude Code environment's variables) before starting `claude`.
KIE_API_KEY=
